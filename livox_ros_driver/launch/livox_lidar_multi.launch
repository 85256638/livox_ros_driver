<launch>

    <!-- Arguments -->
    <arg name="config_file" default="$(find livox_ros_driver)/config/livox_lidar_config_multi.json"/>
    <arg name="xfer_format" default="0"/>
    <arg name="multi_topic" default="1"/>  <!-- Enable multi-topic mode -->
    <arg name="msg_frame_id" default="livox_frame"/>
    <arg name="data_src" default="0"/>
    <arg name="publish_freq" default="10.0"/>
    <arg name="output_type" default="0"/>
    <arg name="rviz_enable" default="false"/>
    <arg name="rosbag_enable" default="false"/>
    <arg name="lidar_bag" default="false"/>
    <arg name="imu_bag" default="false"/>
    <arg name="max_distance" default="25.0"/>
    <arg name="monitor" default="true"/>   <!-- auto-open the stats dashboard in its own terminal window; set false on headless/SSH hosts -->
    <!-- LIVOX_MONITOR_LAYOUT_V1: fixed-height compact default with explicit diagnostic fallbacks. -->
    <arg name="monitor_layout" default="compact"/>   <!-- compact: fixed-height live view; full: all diagnostics; history: one-shot history -->
    <arg name="auto_recover" default="false"/>   <!-- true: auto-recover a Normal-but-no-data lidar (restart sampling, then reboot) -->
    <arg name="health_log" default="false"/>   <!-- true: write CSV health logs (edge-triggered events + periodic snapshot) for long-run trend/forensics -->
    <arg name="health_log_dir" default=""/>   <!-- output dir; empty = node working dir (~/.ros). Must already exist -->
    <arg name="health_log_snapshot_s" default="600"/>   <!-- snapshot cadence in seconds; events are always logged the instant they happen -->
    <arg name="relay_power_cycle_enable" default="false"/>   <!-- true: start automatic shared-relay OFF/ON; false: do not start the manager or read its JSON -->


    <!-- Livox Configuration -->
    <param name="xfer_format" value="$(arg xfer_format)"/>
    <param name="multi_topic" value="$(arg multi_topic)"/>

    <remap from="/livox/lidar_3WEDH7600111191" to="/livox/lidar_farleft_2"/>
    <remap from="/livox/lidar_3WEDH5900103621" to="/livox/lidar_left_57"/>
    <remap from="/livox/lidar_3WEDH5900100671" to="/livox/lidar_mid_65"/>
    <remap from="/livox/lidar_3WEDH7600103661" to="/livox/lidar_right_75"/>

    <remap from="/livox/imu_3WEDH7600111191" to="/livox/imu_farleft_2"/>
    <remap from="/livox/imu_3WEDH5900103621" to="/livox/imu_left_57"/>
    <remap from="/livox/imu_3WEDH5900100671" to="/livox/imu_mid_65"/>
    <remap from="/livox/imu_3WEDH7600103661" to="/livox/imu_right_75"/>

    <remap from="/livox/status_3WEDH7600111191" to="/livox/status_farleft_2"/>
    <remap from="/livox/status_3WEDH5900103621" to="/livox/status_left_57"/>
    <remap from="/livox/status_3WEDH5900100671" to="/livox/status_mid_65"/>
    <remap from="/livox/status_3WEDH7600103661" to="/livox/status_right_75"/>

    <param name="data_src" value="$(arg data_src)"/>
    <param name="publish_freq" type="double" value="$(arg publish_freq)"/>
    <param name="output_data_type" value="$(arg output_type)"/>
    <param name="user_config_path" type="string" value="$(arg config_file)"/>
    <!-- param name="frame_id" type="string" value="$(arg msg_frame_id)"/ -->
    <param name="enable_lidar_bag" type="bool" value="$(arg lidar_bag)"/>
    <param name="enable_imu_bag" type="bool" value="$(arg imu_bag)"/>
    <param name="max_distance" type="double" value="$(arg max_distance)"/>   <!-- 加这行 -->
    <param name="auto_recover" type="bool" value="$(arg auto_recover)"/>
    <param name="health_log" type="bool" value="$(arg health_log)"/>
    <param name="health_log_dir" type="string" value="$(arg health_log_dir)"/>
    <param name="health_log_snapshot_s" type="int" value="$(arg health_log_snapshot_s)"/>

    <!-- LIVOX_RELAY_LAUNCH_INTEGRATION -->
    <include file="$(find livox_ros_driver)/launch/livox_power_cycle.launch">
        <arg name="enable" value="$(arg relay_power_cycle_enable)"/>
    </include>
    <!-- End stable relay power-cycle include. -->


    <!-- Add TF Transformations for 4 LiDARs -->
    <node pkg="tf" type="static_transform_publisher" name="base_to_livox_lidar"
          args="0 0 0 0 0 0 /base_link /livox_frame 5"/>

    <!-- Start Livox Driver -->
    <node name="livox_driver" pkg="livox_ros_driver"
          type="livox_ros_driver_node" required="true"
          output="screen"/>



    <!-- Optional: auto-open the live stats dashboard in its own terminal window.
         Needs a desktop / gnome-terminal (X11 DISPLAY). Enable with monitor:=true.
         Kept in a separate window so its in-place redraw never mixes with the
         driver's scrolling logs.
         The default compact layout is fixed-height and fits the 140x30 window
         without scrolling for a four-LiDAR site. Full diagnostics remain
         available with monitor_layout:=full. -->
    <node if="$(arg monitor)" name="livox_stats_monitor" pkg="livox_ros_driver"
          type="livox_stats_monitor.py" output="screen"
          args="--layout $(arg monitor_layout)"
          launch-prefix="gnome-terminal --geometry=140x30 --wait --"/>

    <!-- Optional: Enable RViz -->
    <group if="$(arg rviz_enable)">
        <node name="rviz" pkg="rviz" type="rviz" respawn="true"
              args="-d $(find livox_ros_driver)/config/display_lidar_points_multi.rviz"/>
    </group>


</launch>
