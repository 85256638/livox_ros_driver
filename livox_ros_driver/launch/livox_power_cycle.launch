<launch>

    <!-- LIVOX_POWER_CYCLE_CHILD_V1: keep relay process policy out of site-edited launch files. -->
    <arg name="enable" default="false"/>

    <!-- Armed is fail-closed: a manager exit shuts down the launch so the
         production service can restart the whole recovery chain. Enabling
         relay recovery also forces the Driver's prerequisite recovery state
         machine on before livox_ros_driver_node starts. -->
    <group if="$(arg enable)">
        <param name="/auto_recover" type="bool" value="true"/>
        <node name="livox_power_cycle_manager" pkg="livox_ros_driver"
              type="livox_power_cycle_manager.py" output="screen" required="true"
              args="--config $(env HOME)/.config/livox/power_cycle.json --state-db $(env HOME)/.local/state/livox-power-cycle-manager/state.sqlite3 --mode armed --repair-before-start"/>
    </group>

    <!-- Disabled means fully disabled: no manager process, JSON access, or
         relay network access. Persisted must-be-ON repair is deliberately
         owned by the production systemd startup/shutdown safety hooks. -->

</launch>
