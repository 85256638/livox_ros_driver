<launch>
  <!-- Livox LiDAR with Control Features Launch File -->
  
  <!-- 基本参数设置 -->
  <arg name="xfer_format" default="0"/>
  <arg name="multi_topic" default="0"/>
  <arg name="data_src" default="0"/>
  <arg name="publish_freq" default="10.0"/>
  <arg name="output_data_type" default="0"/>
  <arg name="frame_id" default="livox_frame"/>
  <arg name="enable_lidar_bag" default="true"/>
  <arg name="enable_imu_bag" default="false"/>
  
  <!-- 新增：状态发布参数 -->
  <arg name="status_publish_interval" default="1.0"/>
  
  <!-- 配置文件路径 -->
  <arg name="user_config_path" default="$(find livox_ros_driver)/config/livox_lidar_config.json"/>
  
  <!-- 命令行广播码 -->
  <arg name="cmdline_str" default=""/>
  
  <!-- 启动Livox ROS Driver节点 -->
  <node name="livox_lidar_publisher" pkg="livox_ros_driver" type="livox_ros_driver_node" output="screen">
    <!-- 基本参数 -->
    <param name="xfer_format" value="$(arg xfer_format)"/>
    <param name="multi_topic" value="$(arg multi_topic)"/>
    <param name="data_src" value="$(arg data_src)"/>
    <param name="publish_freq" value="$(arg publish_freq)"/>
    <param name="output_data_type" value="$(arg output_data_type)"/>
    <param name="frame_id" value="$(arg frame_id)"/>
    <param name="enable_lidar_bag" value="$(arg enable_lidar_bag)"/>
    <param name="enable_imu_bag" value="$(arg enable_imu_bag)"/>
    
    <!-- 配置文件路径 -->
    <param name="user_config_path" value="$(arg user_config_path)"/>
    
    <!-- 命令行广播码 -->
    <param name="cmdline_str" value="$(arg cmdline_str)"/>
    
    <!-- 新增：状态发布间隔 -->
    <param name="status_publish_interval" value="$(arg status_publish_interval)"/>
  </node>
  
  <!-- 启动RViz进行可视化（可选） -->
  <group if="$(eval arg('multi_topic') == 0)">
    <!-- 单话题模式下的RViz配置 -->
    <node name="rviz" pkg="rviz" type="rviz" args="-d $(find livox_ros_driver)/config/display_lidar_points.rviz" output="screen"/>
  </group>
  
  <group if="$(eval arg('multi_topic') == 1)">
    <!-- 多话题模式下的RViz配置 -->
    <node name="rviz" pkg="rviz" type="rviz" args="-d $(find livox_ros_driver)/config/display_lidar_points_multi.rviz" output="screen"/>
  </group>
  
  <!-- 状态监控节点（可选） -->
  <node name="lidar_status_monitor" pkg="rostopic" type="rostopic" args="echo /livox/status" output="screen" if="$(eval arg('multi_topic') == 0)"/>
  
  <!-- 多话题模式下的状态监控 -->
  <group if="$(eval arg('multi_topic') == 1)">
    <node name="lidar_status_monitor" pkg="rostopic" type="rostopic" args="echo /livox/status" output="screen"/>
  </group>
  
</launch> 